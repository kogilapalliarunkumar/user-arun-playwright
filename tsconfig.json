{
  "compilerOptions": {
    "baseUrl": ".",
    "types": ["node"],
    "target": "ES6",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "/dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "6.0",
    "resolveJsonModule": true,
    "paths": {
       "@resource/*": ["resources/*"],
       "@pages/*":["Pages/*"],
       "@lib/*":["lib/*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}